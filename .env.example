# ============================================================
# Nexora Smart Edu — Environment Variables
# Copy to .env and fill in production values.
# NEVER commit .env to version control.
#
# Environment separation: development / test / staging / production.
# Production refuses to start with missing secrets, dev-default secrets,
# or no BIOMETRIC_PROVIDER (see apps/api/src/config/configuration.ts).
# ============================================================

NODE_ENV=development

# ---- Database ----
# Development: local docker-compose (owner role is fine for dev).
# Production: use the least-privilege app role, e.g.
#   postgres://nexora_app:<strong-password>@<host>:5432/nexora
# Run migrations as the OWNER (nexora), not as nexora_app.
DATABASE_URL=postgres://nexora:<YOUR_DB_PASSWORD>@localhost:5433/nexora

# ---- JWT (MUST be strong random secrets in production; dev defaults
#      are rejected when NODE_ENV=production) ----
JWT_SECRET=dev_access_secret_change_me_00000000000000000000000000000000
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0000000000000000000000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- API ----
API_PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
# Set true only behind a TLS-terminating proxy (Cloudflare/Render/Railway).
TRUST_PROXY=false
# Prod: the frontend cookie domain, e.g. .nexora.example — leave empty for dev.
COOKIE_DOMAIN=

# ---- Providers (dev-safe placeholders) ----
# BIOMETRIC_PROVIDER=dev is BLOCKED in production — a real verification
# engine (InsightFace/ONNX/cloud/device-based) must be configured.
BIOMETRIC_PROVIDER=dev
STORAGE_PROVIDER=local
EMAIL_PROVIDER=console
# Optional: require an invite code for school self-registration.
INVITE_CODE=

# ---- Observability ----
LOG_LEVEL=info

# ---- Frontend (web app) ----
# In production builds NEXT_PUBLIC_API_URL is REQUIRED; the build fails fast
# if it is missing so the app never silently points at localhost.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Set 'true' only in dev to show demo credentials on the login screen.
NEXT_PUBLIC_SHOW_DEMO_CREDS=false
# ===== Production hardening (R2) =====
# Runtime database connection using a NON-OWNER login role (nexora_app).
# In production this is REQUIRED: the app must never connect as the table
# owner (owner bypasses RLS). Migrations still use DATABASE_URL (owner).
APP_DATABASE_URL=

# Data-plane mode: 'shared' (platform RLS-protected DB) | 'dedicated'
# (per-school database/Postgres project; requires the tenant router to be
# enabled and per-tenant secrets provisioned in the secret store).
DATA_PLANE_MODE=shared
